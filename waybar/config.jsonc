{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/weather", "clock"],
    "modules-right": [
        "pulseaudio",
        "network",
        "bluetooth",
        "battery",
        "custom/power-profile",
        "backlight",
        "custom/clipboard",
        "custom/settings",
        "custom/lock",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 muted",
        "on-click": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "SUPER+A to open pavucontrol"
    },

    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-disconnected": "󰤭 disconnected",
        "on-click": "nm-connection-editor",
        "tooltip": true,
        "tooltip-format": "Networl: {essid}\nClick to handle connections"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-disabled": "󰂲 disabled",
        "format-off": "󰂲 disabled",
        "on-click": "blueman-manager",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
        "tooltip": true,
        "tooltip-format": "{controller_alias}\n{num_connections} connected"
    },
    
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "{timeTo}"
    },

    "custom/power-profile": {
        "exec": "powerprofilesctl get",
        "interval": 5,
        "format": " ⚡ {} ",
        "on-click": "powerprofilesctl set $(powerprofilesctl list | grep -v '*' | grep -oP '(?<=  )[a-z-]+' | wofi --dmenu)",
        "tooltip": false
    },

    "custom/clipboard": {
        "format": " 󰅇 ",
        "on-click": "cliphist list | wofi --dmenu | cliphist decode | wl-copy",
        "tooltip": true,
        "tooltip-format": "SUPER+V to open history"
    },

    "custom/settings": {
        "format": " 󰒓 ",
        "on-click": "nwg-look",
        "tooltip": true,
        "tooltip-format": "Appearance settings"
    },

    "custom/lock": {
        "format": " 󰌾 ",
        "on-click": "hyprlock",
        "tooltip": true,
        "tooltip-format": "SUPER+L to lock"
    },

    "custom/power": {
        "format": " ⏻ ",
        "on-click": "~/.config/waybar/power-menu.sh",
        "tooltip": false
    },
  
    "backlight": {
        "format": " {icon} {percent}% ",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/weather/get_weather.rb",
        "on-click": "~/.config/waybar/scripts/weather/get_weather.rb --next", // Cycle views
        "interval": 900 // Every 15 minutes
    }
}
